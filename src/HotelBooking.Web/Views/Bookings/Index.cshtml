@model MyBookingsViewModel
@{
    ViewData["Title"] = "My Bookings - Pure Stay Hotel";
}

<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h1 class="h2 fw-bold mb-1">My Bookings</h1>
            <p class="text-muted mb-0 small">Review and manage your hotel reservations</p>
        </div>
        <div>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary fw-semibold">
                + Book Another Room
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            ✅ @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            ⚠️ @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (Model.Bookings.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-light my-4">
            <div class="card-body py-4">
                <div class="display-3 mb-3">🧳</div>
                <h3 class="h4 fw-bold">No bookings found</h3>
                <p class="text-muted mx-auto mb-4" style="max-width: 450px;">
                    You haven't made any reservations with us yet. Start exploring our rooms and suites to plan your next stay!
                </p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg px-4 fw-semibold">
                    Find a Room
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model.Bookings)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="row g-0 align-items-center">
                            <!-- Room Image -->
                            <div class="col-md-3">
                                <img src="@(item.ImageUrl ?? "https://picsum.photos/seed/room" + item.RoomNumber + "/800/500")"
                                     class="img-fluid h-100 w-100"
                                     style="min-height: 180px; max-height: 220px; object-fit: cover;"
                                     alt="Room @item.RoomNumber" />
                            </div>

                            <!-- Booking Details -->
                            <div class="col-md-6 p-4">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    @if (item.Status == BookingStatus.Confirmed)
                                    {
                                        <span class="badge bg-success rounded-pill px-3 py-1">Confirmed</span>
                                    }
                                    else if (item.Status == BookingStatus.Cancelled)
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3 py-1">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark rounded-pill px-3 py-1">@item.Status</span>
                                    }

                                    <span class="text-muted small">Ref: <strong>@item.Reference</strong></span>
                                </div>

                                <h3 class="h5 fw-bold mb-2">Room @item.RoomNumber - @item.RoomTypeName</h3>

                                <div class="row g-2 text-muted small mt-2">
                                    <div class="col-sm-6">
                                        <div>📅 <strong>Check-in:</strong> @item.CheckIn.ToString("dd MMM yyyy")</div>
                                        <div>📅 <strong>Check-out:</strong> @item.CheckOut.ToString("dd MMM yyyy")</div>
                                    </div>
                                    <div class="col-sm-6">
                                        <div>🌙 <strong>Duration:</strong> @item.Nights night@(item.Nights > 1 ? "s" : "")</div>
                                        <div>👥 <strong>Guests:</strong> @item.Guests guest@(item.Guests > 1 ? "s" : "")</div>
                                    </div>
                                </div>

                                <div class="text-muted extra-small mt-2">
                                    Booked on @item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                            </div>

                            <!-- Pricing and Actions -->
                            <div class="col-md-3 p-4 bg-light border-start text-md-end d-flex flex-column justify-content-between h-100">
                                <div>
                                    <span class="text-muted small d-block">Total Paid / Due</span>
                                    <span class="fs-4 fw-bold text-dark">₹@item.TotalPrice.ToString("N0")</span>
                                </div>

                                <div class="mt-3">
                                    @if (item.CanCancel)
                                    {
                                        <form asp-action="Cancel" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Are you sure you want to cancel booking @item.Reference?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm w-100 fw-semibold">
                                                Cancel Booking
                                            </button>
                                        </form>
                                        <div class="extra-small text-muted mt-1 text-center">
                                            Free cancellation active
                                        </div>
                                    }
                                    else if (item.Status == BookingStatus.Confirmed)
                                    {
                                        <span class="text-muted extra-small d-block text-center">
                                            Cancellation window closed
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
