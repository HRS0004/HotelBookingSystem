@using Microsoft.AspNetCore.Identity
@using HotelBooking.Web.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center">
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = !string.IsNullOrWhiteSpace(currentUser?.FullName) ? currentUser.FullName : User.Identity?.Name;
    <li class="nav-item me-lg-2">
        <span class="nav-link text-dark fw-semibold">Hello @displayName!</span>
    </li>
    <li class="nav-item">
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })" method="post">
            <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark fw-medium" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li class="nav-item ms-lg-2">
        <a class="btn btn-primary btn-sm px-3 fw-semibold" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
