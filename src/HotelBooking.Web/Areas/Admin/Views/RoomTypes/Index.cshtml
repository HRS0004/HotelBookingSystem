@model IEnumerable<RoomTypeListItemViewModel>
@{
    ViewData["Title"] = "Room Types";
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-2 pb-3 mb-3 border-bottom">
    <div>
        <h1 class="h2 mb-1 fw-bold text-dark">Room Types</h1>
        <p class="text-muted mb-0">Manage hotel room categories, baseline rates, and guest capacities.</p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0">
        <a asp-area="Admin" asp-controller="RoomTypes" asp-action="Create" class="btn btn-primary">
            ➕ Add Room Type
        </a>
    </div>
</div>

<div class="card admin-card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="p-5 text-center text-muted">
                <h4>No room types found</h4>
                <p>Click "Add Room Type" to create your first room category.</p>
                <a asp-area="Admin" asp-controller="RoomTypes" asp-action="Create" class="btn btn-primary mt-2">Create Room Type</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Base Price</th>
                            <th>Capacity</th>
                            <th>Rooms in Hotel</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fs-6 fw-bold text-dark">@item.Name</span>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided." : item.Description)
                                    </span>
                                </td>
                                <td>
                                    <span class="fw-bold text-primary">₹@item.BasePrice.ToString("N0")</span>
                                    <span class="text-muted small">/ night</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        👥 @item.Capacity @(item.Capacity == 1 ? "guest" : "guests")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary-emphasis">
                                        @item.RoomsCount @(item.RoomsCount == 1 ? "room" : "rooms")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-area="Admin" asp-controller="RoomTypes" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                        ✏️ Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
