@page
@model RegisterModel
@{
    ViewData["Title"] = "Register - Pure Stay Hotel";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card border-0 shadow rounded-4 p-4 p-md-5">
            <div class="text-center mb-4">
                <span class="fs-1">🏨</span>
                <h1 class="h3 fw-bold text-dark mt-2">Create an Account</h1>
                <p class="text-muted small">Join Pure Stay Hotel to manage your bookings and enjoy exclusive stays.</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="Input.FullName" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Input.FullName" class="form-control" autocomplete="name" placeholder="John Doe" />
                    <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Input.Password" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.ConfirmPassword" class="form-label fw-semibold small text-secondary"></label>
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" placeholder="••••••••" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-3">
                    <button id="registerSubmit" type="submit" class="btn btn-primary btn-lg fw-semibold shadow-sm">
                        Create Account
                    </button>
                </div>

                <div class="text-center small text-muted">
                    Already have an account?
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-primary fw-semibold text-decoration-none">Log in</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
